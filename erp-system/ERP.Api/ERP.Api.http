@ERP.Api_HostAddress = http://localhost:5000



GET {{ERP.Api_HostAddress}}/products
Accept: application/json

###

# Search products by name (partial match, case-insensitive)
GET {{ERP.Api_HostAddress}}/products?q=laptop
Accept: application/json

###

# Search products - another example
GET {{ERP.Api_HostAddress}}/products?q=Sample
Accept: application/json

###

# Filter products by category name
GET {{ERP.Api_HostAddress}}/products?category=Electronics
Accept: application/json

###

# Search by name AND filter by category
GET {{ERP.Api_HostAddress}}/products?q=laptop&category=Electronics
Accept: application/json

###


GET {{ERP.Api_HostAddress}}/products?page=2&pageSize=2
Accept: application/json

###

GET {{ERP.Api_HostAddress}}/products/2
Accept: application/json

###

POST {{ERP.Api_HostAddress}}/products
Content-Type: application/json

{
  "name": "laptop",
  "sku": "SKU005",
  "slug": "laptop1",
  "categoryId": 1,
  "unitPrice": 29.99,
  "costPrice": 15.00,
  "stockQty": 100,
  "barcode": "1234567890123",
  "isActive": true
}

###

PUT {{ERP.Api_HostAddress}}/products/1
Content-Type: application/json

{
  "name": "Updated Product Name",
  "sku": "SKU001-UPDATED",
  "slug": "updated-product-name",
  "categoryId": 2,
  "unitPrice": 39.99,
  "costPrice": 20.00,
  "stockQty": 75,
  "barcode": "9876543210987",
  "isActive": true
}

###

DELETE {{ERP.Api_HostAddress}}/products/1
Accept: application/json

###

# Categories Endpoints

GET {{ERP.Api_HostAddress}}/categories
Accept: application/json

###

GET {{ERP.Api_HostAddress}}/categories/1
Accept: application/json

###

POST {{ERP.Api_HostAddress}}/categories
Content-Type: application/json

{
  "name": "Electronics",
  "slug": "electronics",
  "description": "Electronic devices and accessories"
}

###

PUT {{ERP.Api_HostAddress}}/categories/1
Content-Type: application/json

{
  "name": "Electronics & Gadgets",
  "slug": "electronics-gadgets",
  "description": "Updated description for electronic devices"
}

###

DELETE {{ERP.Api_HostAddress}}/categories/1
Accept: application/json

